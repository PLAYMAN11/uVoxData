{
    "name": "uvoxdata/frontend",
    "description": "Frontend Laravel para uVoxData",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.59",
        "guzzlehttp/guzzle": "^7.10"
    },
    "require-dev": {
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
